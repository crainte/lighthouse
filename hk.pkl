// Quality gates, defined once and used three ways:
//   - git hooks: `pre-commit` runs the fast steps, `pre-push` the full Rust suite
//   - locally:   `hk check` (fast) or `hk check --all --slow` (everything CI runs)
//   - CI:        .github/workflows/ci.yml runs one job per step via
//                `hk check --all --slow -S <step>`, so a failure names its cause
// Steps tagged `slow` (audits, builds, full test suite) stay out of the hooks.
// `backup-restore-smoke` is in the local-only `smoke` profile and never runs in CI:
//   hk check -p smoke -S backup-restore-smoke
// `conventional-commits` is in the `pr` profile and runs only on pull requests.
amends "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Builtins.pkl"

local rust = List("**/*.rs", "Cargo.toml", "Cargo.lock", "build.rs")
local frontend = List("frontend/src/**", "frontend/*.json", "frontend/*.ts", "frontend/bun.lock")

local linters = new Mapping<String, Step> {
  // `cargo fmt` rather than bare `rustfmt`: it reads the crate's edition from
  // Cargo.toml, where per-file rustfmt defaults to its own and reorders imports.
  ["fmt"] = Builtins.cargo_fmt
  ["whitespace"] {
    glob = "**/*"
    check = "git diff --cached --check"
  }
  // Check-only: the builtin's `clippy --fix` would rewrite code mid-commit.
  ["clippy"] {
    glob = rust
    check = "cargo clippy --locked --all-targets -- -D warnings"
  }
  // Unit tests only: ~20s. The integration suites (cluster, gossip, restart)
  // take minutes of compiling and server spin-up, so they gate the push instead.
  ["unit-test"] {
    glob = rust
    check = "cargo test --locked --lib"
  }
  ["svelte-check"] {
    glob = frontend
    check = "cd frontend && npx svelte-check --threshold error"
  }
  ["vitest"] {
    glob = frontend
    check = "cd frontend && npx vitest run"
  }
}

// CI-only gates. Frontend steps expect `bun install --frozen-lockfile` to have run.
local slow = new Mapping<String, Step> {
  // Unset: several tests assert behaviour for an agent with no ambient
  // credential (see tests/ws_api.rs), so an exported token would make them flaky.
  // Script rather than bare `cargo test`: it loads a native backtrace hook into
  // test binaries, because this gate intermittently dies with a libstdc++
  // `pure virtual method called` abort at teardown that names no component.
  ["test"] {
    profiles = List("slow")
    check = "bash scripts/ci-test.sh"
  }
  ["frontend-build"] {
    profiles = List("slow")
    check = "cd frontend && bun run build"
  }
  ["cargo-audit"] {
    profiles = List("slow")
    check = "cargo audit"
  }
  ["cargo-machete"] {
    profiles = List("slow")
    check = "cargo-machete --with-metadata"
  }
  ["bun-audit"] {
    profiles = List("slow")
    check = "cd frontend && bun audit --ignore=GHSA-gcqx-w48m-w2h4"
  }
  ["docker-build"] {
    profiles = List("slow")
    // DOCKER_BUILD_FLAGS is empty locally; CI sets it to the shared gha cache.
    check = "docker buildx build ${DOCKER_BUILD_FLAGS:-} --build-arg GIT_SHA=$(git rev-parse --short=12 HEAD) -t lighthouse:gate ."
  }
  ["actionlint"] {
    profiles = List("slow")
    check = "actionlint"
  }
  // Pull-request commit messages and title, via .github/workflows/commit-lint.yml:
  //   hk check -p pr -S conventional-commits
  // Its own profile because it needs a commit range (BASE_REF/HEAD_SHA/PR_TITLE),
  // not the working tree, so a plain `hk check --all --slow` leaves it out.
  ["conventional-commits"] {
    profiles = List("pr")
    check = "bash scripts/check-conventional-commits.sh"
  }
  // Starts a real node and round-trips `lighthouse backup` / `restore`.
  ["backup-restore-smoke"] {
    profiles = List("smoke")
    check = "scripts/backup-restore-smoke.sh"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps = new Mapping<String, Step> {
      ["test"] {
        glob = rust
        check = "bash scripts/ci-test.sh"
      }
    }
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = (linters) { ...slow }
  }
}
